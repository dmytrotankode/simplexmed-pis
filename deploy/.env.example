# SimplexMed PIS — змінні оточення бекенду.
# На сервері: скопіювати в /var/www/simplex-pis/.env, заповнити, chmod 600.
# Реальні значення не комітити (*.env ігнорується git).

# PostgreSQL (база simplex-pis-dev на MFX)
PG_HOST=10.0.0.4
PG_PORT=50431
PG_USER=simplex
PG_PASSWORD=
DB_PIS_NAME=simplex-pis-dev

# eHealth (preprod)
PIS_EHEALTH_PSK=
# Файл з client_id / client_secret ПІС (формат key=value) або напряму PIS_CLIENT_ID / PIS_CLIENT_SECRET.
# client_secret ПІС = API-key, який надсилається в кожному запиті до ЕСОЗ.
PIS_CRED_FILE=/var/www/simplex-pis/credentials/Credentials to PIS SimplexMed.txt
#PIS_CLIENT_ID=
#PIS_CLIENT_SECRET=

# Хости ЕСОЗ (за замовчуванням preprod)
#PIS_API_HOST=https://pis-preprod.ehealth.gov.ua
#PIS_AUTH_HOST=https://auth-preprod.ehealth.gov.ua
#PIS_LOGIN_HOST=https://pis-auth-preprod.ehealth.gov.ua
# Скоупи через пробіл, якщо клієнту ПІС видано не всі (за замовчуванням — повний набір ПІС)
#PIS_SCOPES=

# Ключ шифрування токенів ЕСОЗ у БД (Fernet). Згенерувати:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Зміна ключа робить збережені токени недійсними (пацієнти входять через ЕСОЗ заново).
PIS_TOKEN_KEY=

# Назва і контакти підтримки для повідомлень про помилки (Додаток 1 ТВ ПІС)
PIS_NAME=SimplexMed
PIS_SUPPORT_CONTACTS=

# Зареєстрований в eHealth redirect_uri; далі redirect-ehealth.js перенаправляє за state
PIS_REDIRECT_URI=https://simplex-med.com
PIS_PORT=3122
# Слухати лише localhost; назовні — тільки через nginx (TLS)
PIS_HOST=127.0.0.1
APP_ENV=dev

# Кеш реєстрів ЕСОЗ для подання декларацій (п.3.12): SQLite, оновлення у фоні не частіше 4 год і не рідше доби
#PIS_REGISTRY_DB=/var/www/simplex-pis/backend/registry.sqlite3
#PIS_REGISTRY_REFRESH=1

# gunicorn (pis/backend/gunicorn.conf.py): потоки єдиного воркера; довіра X-Forwarded-* від nginx
#PIS_THREADS=8
#PIS_TRUST_PROXY=1
